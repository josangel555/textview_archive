// Hand-written module map for the MarkdownViewer Rust core C ABI (the
// deliberate cbindgen path — NOT uniffi, which would generate this for you
// along with a RustBuffer serialization tax).
//
// `mdvcore.h` is generated by cbindgen (rust-core/crates/ffi/build.rs) and
// copied here by `scripts/build-rust-core.sh` before `swift build`. It is
// gitignored as a build artifact (it regenerates from the Rust source and must
// never drift). The `link "mdvcore_ffi"` line names the dynamic lib
// (libmdvcore_ffi.dylib, shipped in Contents/Frameworks/); the `-L` search path
// + `-rpath` are supplied via the RustCore target's linkerSettings in
// Package.swift.
module CMdvCore {
    header "mdvcore.h"
    link "mdvcore_ffi"
    export *
}

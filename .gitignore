.DS_Store
.build/
.swiftpm/
DerivedData/
xcuserdata/
*.xcuserstate
.idea/
.vscode/
*.xcodeproj/
*.xcworkspace/
build/
dist/

# Iconset is a working dir for iconutil; the resulting .icns is committed
# (Resources/AppIcon.icns) so daily builds don't re-render the iconset.
scripts/AppIcon.iconset/

# Project-local app data: the in-app Code Review feature (#203) writes
# review JSONL under `.textview/reviews/` at runtime. Per-project scratch,
# never committed. (The user-editable keybinding config lives in the HOME
# dotfile `~/.textview/keybinding.json`, not here.)
.textview/

# Claude Code working state. `.claude/worktrees/` holds ephemeral git
# worktrees spawned for parallel agent runs and must never be committed.
# Ignore the whole `.claude/` tree by default; re-include any config we
# deliberately want tracked by un-ignoring it below.
.claude/
# Example: keep a checked-in project config if/when we add one:
# !.claude/settings.json
# Perf-capture scratch (vm-profile / interact-signposted fixture files).
.profiling/

{
  "name": "mdv-cm6-bundle",
  "version": "0.0.0",
  "private": true,
  "description": "Build-only workspace that bundles CodeMirror 6 into Sources/ViewerUI/Resources/codemirror/codemirror.{js,css}. Not part of the runtime app — esbuild + the @codemirror/* packages are install-once tools, not Swift dependencies.",
  "scripts": {
    "build": "esbuild entry.js --bundle --format=iife --global-name=CM --minify --target=safari17 --outfile=../../Sources/ViewerUI/Resources/codemirror/codemirror.js --loader:.css=text",
    "build-dev": "esbuild entry.js --bundle --format=iife --global-name=CM --target=safari17 --outfile=../../Sources/ViewerUI/Resources/codemirror/codemirror.js --loader:.css=text"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.6.0",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-html": "6.4.11",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "6.2.2",
    "@codemirror/lang-json": "6.0.1",
    "@codemirror/lang-markdown": "6.2.5",
    "@codemirror/lang-python": "6.1.6",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/language": "6.10.2",
    "@codemirror/legacy-modes": "6.5.3",
    "@codemirror/lint": "6.8.1",
    "@codemirror/merge": "6.12.2",
    "@codemirror/search": "6.5.6",
    "@codemirror/state": "6.6.0",
    "@codemirror/theme-one-dark": "6.1.2",
    "@codemirror/view": "6.43.0",
    "@replit/codemirror-vim": "6.3.0",
    "esbuild": "0.25.0"
  }
}

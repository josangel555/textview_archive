<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>TextView</string>
    <key>CFBundleExecutable</key>
    <string>MarkdownViewer</string>
    <key>CFBundleIdentifier</key>
    <string>com.markdownviewer.MarkdownViewer</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>TextView</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>15.0</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.developer-tools</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSHumanReadableCopyright</key>
    <string>© 2026 TextView</string>
    <!-- TCC usage descriptions. macOS prompts the user the first time the
         app reads from any of these protected locations; with a usage
         description, the system remembers the answer (instead of asking
         every time) and shows the description in the prompt. -->
    <key>NSDocumentsFolderUsageDescription</key>
    <string>TextView reads files from your Documents folder to display them.</string>
    <key>NSDesktopFolderUsageDescription</key>
    <string>TextView reads files from your Desktop to display them.</string>
    <key>NSDownloadsFolderUsageDescription</key>
    <string>TextView reads files from your Downloads folder to display them.</string>
    <key>NSRemovableVolumesUsageDescription</key>
    <string>TextView reads files on removable volumes to display them.</string>
    <key>NSNetworkVolumesUsageDescription</key>
    <string>TextView reads files on network volumes to display them.</string>
    <!-- Finder Quick Action / Services menu entry: right-click any file
         or folder in Finder → Services → "Open in TextView". macOS
         routes the selection's file URLs to AppDelegate.openInTextView
         via NSPasteboard. No bundled .workflow needed. -->
    <key>NSServices</key>
    <array>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Open in TextView</string>
            </dict>
            <key>NSMessage</key>
            <string>openInTextView</string>
            <key>NSPortName</key>
            <string>TextView</string>
            <key>NSSendTypes</key>
            <array>
                <string>NSFilenamesPboardType</string>
                <string>public.file-url</string>
            </array>
            <key>NSRequiredContext</key>
            <dict>
                <key>NSTextContent</key>
                <string>FilePath</string>
            </dict>
        </dict>
    </array>
    <!-- TSK-327: the in-app tool-window drag payload type. SwiftUI's
         .draggable/.dropDestination use UTType(exportedAs:
         "com.markdownviewer.panel-drag") — an EXPORTED type MUST be
         declared here, or the drag payload writes to the pasteboard but
         no drop zone ever accepts it (the silently-dead drag). -->
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.markdownviewer.panel-drag</string>
            <key>UTTypeDescription</key>
            <string>TextView tool-window drag payload</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
            </array>
        </dict>
        <!-- TSK-1317: the terminal shoulder-icon drag payload. Dragging the
             terminal toggle onto a shoulder docks the pane to that edge
             (setPaneEdge). Same exported-UTI requirement as panel-drag above. -->
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.markdownviewer.terminal-drag</string>
            <key>UTTypeDescription</key>
            <string>TextView terminal-pane drag payload</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
            </array>
        </dict>
    </array>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>TextView URL Scheme</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>textview</string>
                <string>markdownviewer</string>
            </array>
        </dict>
    </array>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Markdown Document</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>net.daringfireball.markdown</string>
                <string>public.markdown</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Plain Text</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.plain-text</string>
                <string>public.text</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Source Code</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.source-code</string>
                <string>public.swift-source</string>
                <string>public.json</string>
                <string>public.xml</string>
                <string>public.yaml</string>
                <string>public.python-script</string>
                <string>public.shell-script</string>
                <string>public.script</string>
                <string>com.netscape.javascript-source</string>
                <string>public.css</string>
                <string>public.html</string>
                <string>public.c-source</string>
                <string>public.c-plus-plus-source</string>
                <string>public.objective-c-source</string>
                <string>public.assembly-source</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Folder</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.folder</string>
                <string>public.directory</string>
            </array>
        </dict>
    </array>
</dict>
</plist>

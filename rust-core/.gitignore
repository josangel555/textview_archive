# The staged link artifacts are regenerated by scripts/build-rust-core.sh from
# the crate source — never commit them. Committing the staticlib would bloat
# the repo (~17 MB) and pin an arm64-only binary into history.
/link/

# cbindgen mirrors the header here from build.rs; it regenerates from the
# extern "C" surface and must never drift (so never commit it).
/crates/ffi/include/

# Cargo's local build dir IF someone forgets to set CARGO_TARGET_DIR. The
# canonical build dir is external (/private/tmp/.../mdv-rust-csv-target) per
# worktree hygiene; this is a backstop so a stray ./target never gets staged.
/target/
